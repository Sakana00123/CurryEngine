<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GeneratedRoot Condition="'$(GeneratedRoot)' == ''">$(MSBuildProjectDirectory)\..\Generated</GeneratedRoot>
	<AssemblyName>CurryEngine.API</AssemblyName>
	<RootNamespace>CurryEngine</RootNamespace>
	<Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="$(GeneratedRoot)\CSharp\Wrappers\*.g.cs">
      <Link>Wrappers\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Core プロジェクトを参照 -->
    <ProjectReference Include="..\CurryEngine.Core\CurryEngine.Core.csproj" />
    <!-- Runtime プロジェクトを参照-->
    <ProjectReference Include="..\CurryEngine.Runtime\CurryEngine.Runtime.csproj" />
    <!-- CurryEngine.Coreに対して内部可視性を許可する -->
    <InternalsVisibleTo Include="CurryEngine.Core" />
  </ItemGroup>
	
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipEngineCopy)' != 'true'">
	<Copy SourceFiles="$(OutDir)CurryEngine.API.dll" DestinationFolder="$(MSBuildProjectDirectory)\..\x64\$(Configuration)\" />
	<Copy SourceFiles="$(OutDir)CurryEngine.API.pdb" DestinationFolder="$(MSBuildProjectDirectory)\..\x64\$(Configuration)\" />
  </Target>
</Project>
