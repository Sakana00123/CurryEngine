<?xml version="1.0" encoding="utf-8"?>
<!--
  CurryEngine.GeneratedFiles.props
  
  自動生成ファイルをコンパイル対象に追加するプロパティシート
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================================
       パス定義
  ============================================================ -->
  <PropertyGroup>
    <GeneratedRoot Condition="'$(GeneratedRoot)' == ''">$(MSBuildProjectDirectory)\Generated</GeneratedRoot>
    <GeneratedInteropDir>$(GeneratedRoot)\Interop</GeneratedInteropDir>
    <GeneratedReflectionDir>$(GeneratedRoot)\Reflection</GeneratedReflectionDir>
  </PropertyGroup>

  <!-- ============================================================
       コンパイル対象に追加
       *.generated.cpp  : Exports など自動生成されたC++ソース
       *.generated.h    : ヘッダーオンリーなので ClCompile 不要
  ============================================================ -->
  <ItemGroup>
    <!-- Interop 層 (Export関数) -->
	<_WildCardClCompile Include="$(GeneratedInteropDir)\*.generated.cpp">
	  <PrecompiledHeader>NotUsing</PrecompiledHeader>
	</_WildCardClCompile>

    <!-- Reflection 層 (REGISTER_CLASS 展開) -->
    <!-- .generated.h はヘッダーなので ClInclude として認識させる -->
    <_WildCardClInclude Include="$(GeneratedReflectionDir)\*.generated.h" />
  </ItemGroup>

  <!-- ============================================================
       インクルードパスに Generated フォルダを追加
       #include "Rigidbody.generated.h" などが解決できるようになる
  ============================================================ -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(GeneratedRoot);
        $(GeneratedInteropDir);
        $(GeneratedReflectionDir);
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>
